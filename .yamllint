extends: default

rules:
  line-length: disable
  document-start: disable
  truthy:
    check-keys: false
  comments-indentation: disable
  braces:
    max-spaces-inside: 1
  # These files are exported/edited via the Home Assistant UI, which writes
  # sequence items at the same indentation as their parent key (not indented
  # one level deeper) — a valid, standard HA convention, not a defect.
  indentation:
    spaces: consistent
    indent-sequences: whatever
